<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YNAB Automation</title>
    <style>
        :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #172033; background: #f5f8fc; }
        * { box-sizing: border-box; }
        body { margin: 0; color: #172033; background: #f5f8fc; }
        .site-header { width: 100%; border-bottom: 1px solid #293650; background: #172033; box-shadow: 0 .15rem .5rem rgb(23 32 51 / 18%); }
        .site-header__content { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; width: min(100% - 2rem, 90rem); min-height: 4.5rem; margin: 0 auto; }
        .site-header__brand { color: #fff; font-size: 1.1rem; font-weight: 750; letter-spacing: .01em; text-decoration: none; white-space: nowrap; }
        .site-nav { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; }
        .site-nav a { padding: .55rem .75rem; border-radius: .4rem; color: #cfdaef; font-size: .94rem; font-weight: 600; text-decoration: none; }
        .site-nav a:hover, .site-nav a:focus-visible { color: #fff; background: #293b60; outline: none; }
        main { width: min(100% - 2rem, 90rem); margin: 2rem auto; }
        button { font: inherit; }
        .validation-summary-errors { margin-bottom: 1rem; padding: .75rem 1rem; border: 1px solid #efb3b3; border-radius: .5rem; color: #9d1717; background: #fff4f4; }
        .message { margin-bottom: 1rem; padding: .75rem 1rem; border: 1px solid #bdd7ff; border-radius: .5rem; background: #eaf3ff; color: #193f7d; }
        form.inline { display: inline; }
        label { display: block; margin: .75rem 0; }
        @@media (max-width: 38rem) { .site-header__content { align-items: flex-start; flex-direction: column; justify-content: center; gap: .5rem; padding: .75rem 0; } main { margin-top: 1.25rem; } }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="site-header__content">
            <a class="site-header__brand" asp-page="/Transactions/Transactions">YNAB Automation</a>
            <nav class="site-nav" aria-label="Primary navigation">
            <a asp-page="/Transactions/Transactions">Pending Transactions</a>
            <a asp-page="/Rules">Merchant Rules</a>
            </nav>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
