@page "/Transactions/Resolve/{id}"
@model YNABAutomationWeb.Pages.Transactions.ResolveModel
@{
    ViewData["Title"] = "Resolve Transaction";
}
<style>
    .resolve-page { max-width: 58rem; }
    .resolve-page__header { margin-bottom: 1.5rem; }
    .resolve-page__header h1 { margin: 0; color: #172033; font-size: clamp(1.75rem, 3vw, 2.25rem); }
    .resolve-page__header p { margin: .4rem 0 0; color: #5d6878; }
    .resolve-page__card { margin-bottom: 1.25rem; padding: 1.25rem; border: 1px solid #dce3ed; border-radius: .75rem; box-shadow: 0 .25rem 1rem rgb(23 32 51 / 8%); background: #fff; }
    .resolve-page__details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; overflow: hidden; border: 1px solid #e1e7ef; border-radius: .5rem; }
    .resolve-page__detail { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1rem; padding: .8rem 1rem; border-bottom: 1px solid #e1e7ef; }
    .resolve-page__detail:nth-child(4n + 1), .resolve-page__detail:nth-child(4n + 2) { background: #f5f8fc; }
    .resolve-page__detail:nth-last-child(-n + 2) { border-bottom: 0; }
    .resolve-page__detail dt { color: #5d6878; font-size: .8rem; font-weight: 700; letter-spacing: .035em; text-transform: uppercase; }
    .resolve-page__detail dd { margin: 0; overflow-wrap: anywhere; color: #172033; font-weight: 600; }
    .resolve-page__history { margin: 0; padding: 0; list-style: none; }
    .resolve-page__history li { padding: .75rem 0; border-bottom: 1px solid #e1e7ef; }
    .resolve-page__history li:last-child { padding-bottom: 0; border-bottom: 0; }
    .resolve-page__form label { color: #354154; font-weight: 600; }
    .resolve-page__form select { display: block; width: min(100%, 28rem); margin-top: .35rem; padding: .5rem .6rem; border: 1px solid #b9c5d5; border-radius: .35rem; background: #fff; color: #172033; }
    .resolve-page__form button { padding: .65rem 1rem; border: 0; border-radius: .4rem; background: #2952cc; color: #fff; cursor: pointer; font-weight: 600; }
    .resolve-page__back { display: inline-block; color: #2546a0; font-weight: 600; }
    @@media (max-width: 42rem) { .resolve-page__details { grid-template-columns: 1fr; } .resolve-page__detail:nth-child(n) { border-bottom: 1px solid #e1e7ef; } .resolve-page__detail:nth-child(odd) { background: #f5f8fc; } .resolve-page__detail:nth-child(even) { background: #fff; } .resolve-page__detail:last-child { border-bottom: 0; } }
    @@media (max-width: 30rem) { .resolve-page__detail { grid-template-columns: 1fr; gap: .25rem; } }
</style>

<section class="resolve-page" aria-labelledby="resolve-heading">
    <div class="resolve-page__header">
        <h1 id="resolve-heading">Resolve Transaction</h1>
        <p>Confirm the category for this transaction and optionally save the decision for future matches.</p>
    </div>
@if (Model.Message is not null)
{
    <p class="message">@Model.Message</p>
}
@if (Model.Transaction is not null)
{
    <div class="resolve-page__card">
    <dl class="resolve-page__details">
        <div class="resolve-page__detail"><dt>YNAB transaction ID</dt><dd>@Model.Transaction.YnabTransactionId</dd></div>
        <div class="resolve-page__detail"><dt>Date</dt><dd>@Model.Transaction.TransactionDate</dd></div>
        <div class="resolve-page__detail"><dt>Original payee</dt><dd>@Model.Transaction.PayeeName</dd></div>
        <div class="resolve-page__detail"><dt>Normalized payee</dt><dd>@Model.Transaction.NormalizedPayee</dd></div>
        <div class="resolve-page__detail"><dt>Amount</dt><dd>@((Model.Transaction.Amount / 1000m).ToString("C"))</dd></div>
        <div class="resolve-page__detail"><dt>Direction</dt><dd>@Model.Transaction.Direction</dd></div>
        <div class="resolve-page__detail"><dt>Account</dt><dd>@Model.Transaction.AccountName</dd></div>
        <div class="resolve-page__detail"><dt>Memo</dt><dd>@Model.Transaction.Memo</dd></div>
        <div class="resolve-page__detail"><dt>Inflow</dt><dd>@Model.Transaction.IsInflow</dd></div>
        <div class="resolve-page__detail"><dt>Transfer</dt><dd>@Model.Transaction.IsTransfer</dd></div>
        <div class="resolve-page__detail"><dt>Status</dt><dd>@Model.Transaction.Status</dd></div>
        <div class="resolve-page__detail"><dt>First seen</dt><dd>@Model.Transaction.FirstSeenAt.UtcDateTime.ToString("u")</dd></div>
        <div class="resolve-page__detail"><dt>Last seen</dt><dd>@Model.Transaction.LastSeenAt.UtcDateTime.ToString("u")</dd></div>
    </dl>
    </div>

    @if (Model.ManualHistory.Count > 0)
    {
        <section class="resolve-page__card" aria-labelledby="history-heading">
        <h2 id="history-heading">Historical categorization</h2>
        <ul class="resolve-page__history">
        @foreach (var decision in Model.ManualHistory)
        {
            <li>@decision.SelectedCategoryId on @decision.CreatedAt.UtcDateTime.ToString("u") (@decision.Reason)</li>
        }
        </ul>
        </section>
    }

    @if (Model.Transaction.Status == TransactionProcessingStatus.ReviewRequired)
    {
        <form method="post" class="resolve-page__card resolve-page__form">
            <h2>Choose a category</h2>
            <div asp-validation-summary="ModelOnly"></div>
            <label asp-for="SelectedCategoryId">Category
                <select asp-for="SelectedCategoryId">
                    <option value="">Select a category</option>
                    @foreach (var group in Model.CategoryGroups)
                    {
                        <optgroup label="@group.Name">
                            @foreach (var category in group.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </label>
            <label>
                <input asp-for="AlwaysCategorizeMerchant" />
                Always categorize this merchant this way
            </label>
            <button type="submit">Categorize</button>
        </form>
    }
}
<p><a class="resolve-page__back" asp-page="/Transactions/Transactions">← Back to pending transactions</a></p>
</section>
