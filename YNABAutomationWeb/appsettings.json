{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ynabautomation"
  },
  "Categorization": {
    "DryRun": false,
    "MinimumLearnedSampleSize": 3,
    "MinimumLearnedConsistency": 0.8
  },
  "OpenAI": {
    "Model": "gpt-5.6-luna",
    "AutoApplyConfidenceThreshold": 0.9,
    "MaximumHistoricalObservations": 5
  },
  "Transfers": {
    "MatchingDateWindowDays": 3
  },
  "Ynab": {
    "BaseUrl": "https://api.ynab.com/v1/"
  }
}
